{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "courses data",
  "type": "object",
  "properties": {
    "semesters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^https?://",
                  "format": "uri"
                }
              },
              "required": [
                "code",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "term",
          "courses"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "semesters"
  ],
  "additionalProperties": false
}
